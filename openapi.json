{
  "openapi": "3.1.0",
  "info": {
    "title": "Figranium API",
    "version": "1.0.0",
    "description": "Public API-key endpoints for task automation, execution results, captures, and cabinets, plus authenticated workspace template catalog endpoints and service metadata."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Public API",
      "description": "API-key endpoints for programmatic automation."
    },
    {
      "name": "Service",
      "description": "Unauthenticated service metadata."
    },
    {
      "name": "Templates",
      "description": "Authenticated workspace endpoints for browsing and retrieving community automation templates. These endpoints require a signed-in workspace session, not an API key."
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Service health check",
        "responses": {
          "200": {
            "description": "Healthy service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Degraded service",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/capabilities": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Describe runtime capabilities",
        "responses": {
          "200": {
            "description": "Runtime capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "tags": [
          "Public API"
        ],
        "summary": "List full task definitions",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Public API"
        ],
        "summary": "Create or replace a task",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Saved task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Task"
              }
            }
          }
        }
      }
    },
    "/api/tasks/list": {
      "get": {
        "tags": [
          "Public API"
        ],
        "summary": "List task summaries",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Task summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tasks": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TaskSummary"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}": {
      "patch": {
        "tags": [
          "Public API"
        ],
        "summary": "Update a task",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Public API"
        ],
        "summary": "Delete a task",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted task",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/tasks/{id}/api": {
      "post": {
        "tags": [
          "Public API"
        ],
        "summary": "Run a saved task",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Task result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionResult"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "/api/executions/list": {
      "get": {
        "tags": [
          "Public API"
        ],
        "summary": "List execution summaries",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Executions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "executions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Execution"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/executions/{id}": {
      "get": {
        "tags": [
          "Public API"
        ],
        "summary": "Get an execution",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Execution",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "execution": {
                      "$ref": "#/components/schemas/Execution"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Execution not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/executions/{id}/result": {
      "get": {
        "tags": [
          "Public API"
        ],
        "summary": "Load an oversized execution result on demand",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Full execution result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/ExecutionResult"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Full result unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/data/captures": {
      "get": {
        "tags": [
          "Public API"
        ],
        "summary": "List recordings and screenshots",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Captures",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "captures": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Capture"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "runId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/captures/{name}": {
      "get": {
        "tags": [
          "Public API"
        ],
        "summary": "Download a capture file",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Capture file",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Capture not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/templates": {
      "get": {
        "tags": [
          "Templates"
        ],
        "summary": "List and search community templates",
        "description": "Without query parameters, returns the complete catalog. Supplying any query parameter returns a paginated list of template summaries; use limit, offset, sort, category, and search to refine the results.",
        "security": [
          {
            "workspaceSession": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of template summaries to return (1–24; default 12).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24,
              "default": 12
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of matching templates to skip.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort order for the catalog.",
            "schema": {
              "type": "string",
              "enum": [
                "popular",
                "newest",
                "name"
              ],
              "default": "popular"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Filter by exact category, or use all categories.",
            "schema": {
              "type": "string",
              "maxLength": 60,
              "default": "all"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive search across template titles, descriptions, authors, categories, and target URLs.",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The full catalog when no query parameters are supplied, or a paginated collection of template summaries otherwise.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TemplatePreset"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/TemplatePage"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination, sorting, category, or search parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "A signed-in workspace session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "The upstream template catalog is unavailable, timed out, or returned invalid data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/templates/{id}": {
      "get": {
        "tags": [
          "Templates"
        ],
        "summary": "Get a template",
        "description": "Returns a template with its workflow configuration, README, and expected output.",
        "security": [
          {
            "workspaceSession": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Template UUID.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Template details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplatePreset"
                }
              }
            }
          },
          "400": {
            "description": "The template ID is not a UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "A signed-in workspace session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "The template does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "The upstream template catalog is unavailable, timed out, or returned invalid data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cabinets": {
      "get": {
        "tags": [
          "Public API"
        ],
        "summary": "List cabinets",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cabinets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cabinets": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Cabinet"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/cabinets/{cabinetId}/items/{itemId}/download": {
      "get": {
        "tags": [
          "Public API"
        ],
        "summary": "Download a cabinet item",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cabinet file",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Cabinet item not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "cabinetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "workspaceSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid",
        "description": "Express session cookie issued after signing in to the Figranium workspace."
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      },
      "TemplatePreset": {
        "type": "object",
        "required": [
          "id",
          "title",
          "configuration"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "author_name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "target_url": {
            "type": "string"
          },
          "downloads": {
            "type": "integer"
          },
          "action_count": {
            "type": "integer"
          },
          "configuration": {
            "type": "object",
            "additionalProperties": true
          },
          "readme": {
            "type": "string"
          },
          "expected_output": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "TemplateSummary": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "author_name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "target_url": {
            "type": "string"
          },
          "downloads": {
            "type": "integer"
          },
          "action_count": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      },
      "TemplatePage": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateSummary"
            }
          },
          "total": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "Task": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "mode": {
            "type": "string",
            "enum": [
              "scrape",
              "agent",
              "headful"
            ]
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "TaskSummary": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Execution": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "timestamp": {
            "type": "number"
          },
          "phase": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "finished"
            ]
          },
          "outcome": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          },
          "taskName": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "result": {
            "$ref": "#/components/schemas/ExecutionResult"
          }
        },
        "additionalProperties": true
      },
      "ExecutionResult": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string"
          },
          "final_url": {
            "type": "string",
            "format": "uri"
          },
          "screenshot_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {},
          "logs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hasFullResult": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "Capture": {
        "type": "object",
        "required": [
          "name",
          "url",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "screenshot",
              "recording"
            ]
          },
          "size": {
            "type": "number"
          },
          "modified": {
            "type": "number"
          }
        }
      },
      "Cabinet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
